# Backend URL reachable FROM THE PHONE.
# - Android emulator: http://10.0.2.2:8000
# - Real device: http://<LAN-IP-of-your-PC>:8000 (same Wi-Fi network)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Test builds only: adds a "Modo prueba sin servidor" switch to the login screen
# (demo user, data kept on the phone, nothing sent). Keep false for real builds.
EXPO_PUBLIC_ALLOW_OFFLINE_MODE=false

# Database (inside Docker use host "postgres"; from the host machine use "localhost")
DATABASE_URL=postgresql+psycopg2://rondas:rondas@postgres:5432/rondas

# Redis (inside Docker use host "redis"; from the host machine use "localhost")
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=change-me-in-dev-too
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Analysis thresholds (business rules — never hardcode these)
WALK_ACCEL_THRESHOLD_MPS2=1.2
INACTIVITY_WINDOW_MIN=5
INACTIVITY_STILL_RATIO=0.8
ROUTE_FRECHET_THRESHOLD_M=100
# Speed limits per route patrol mode (on foot / vehicle, ~60 km/h)
IMPOSSIBLE_SPEED_MPS=3.5
IMPOSSIBLE_SPEED_VEHICLE_MPS=16.7
IMPOSSIBLE_SPEED_MIN_DURATION_S=30
# Vehicle patrols: rule 2 only fires if the GPS also moved less than this
INACTIVITY_VEHICLE_MIN_DISPLACEMENT_M=50
# Telemetry recorded this long before the session start is a stale cached fix
TELEMETRY_MAX_BEFORE_START_S=60
SCAN_MAX_FIX_AGE_S=30
SCAN_MAX_ACCURACY_M=50
PERFORMANCE_DECLINE_RATIO=0.3
FRAUD_SEVERITY_MEDIUM_RATIO=2.0
FRAUD_SEVERITY_HIGH_RATIO=5.0
# UTM 17S (mainland Ecuador), used to compute Frechet distance in meters
PROJECTION_SRID=32717

# Rule 5: checkpoint timing (ratios of actual vs. expected time)
SEGMENT_FAST_RATIO=0.5
SEGMENT_SLOW_RATIO=2.0
SEGMENT_MIN_DELTA_MIN=2
ROUND_SHORT_RATIO=0.5
ROUND_LONG_RATIO=1.5

# Rule 6: GPS moving while the phone lies still
STATIC_ACCEL_STD_MPS2=0.05
STATIC_GYRO_RAD_S=0.03
SENSOR_MISMATCH_MIN_SPEED_MPS=0.8
SENSOR_MISMATCH_MIN_DURATION_S=60

# Rule 7: GPS signal quality
TELEMETRY_GAP_S=120
GPS_JUMP_MIN_DISTANCE_M=100
GPS_JUMP_SPEED_FACTOR=2.0
